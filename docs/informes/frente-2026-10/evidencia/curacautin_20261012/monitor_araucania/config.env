# Monitor ARAUCANÍA — región completa (Malleco y Cautín), costa a cordillera.
# Instanciado el 2026-10-12 tras dos eventos convectivos en cuatro días sin
# monitor NRT en la región (Las Condes 8-oct, Curacautín 12-oct: granizada de
# 20 min, 21 viviendas inundadas) en los que el único sensor con hora y lugar
# correctos fue el GLM; ver docs/informes/frente-2026-10 (A24–A29).
# Derivado de monitor/config.env; cambian bbox, WORK_DIR, susceptibilidad,
# umbral, GLM (activo) y pluviómetros.
# Borde oeste en −73.25 y no en la costa: a −73.35/−73.45 tres celdas eran
# casi todo mar (<5 % de terreno) y make_susc_grid abortaba. Las tres celdas
# del borde NE (lon −71.05, lat −37.65..−37.85, susc 0.36 en el borde del
# ráster del Biobío) quedan MUDAS a propósito (--allow-mute): su peligro
# máximo no alcanza el umbral.
BBOX="-73.25,-39.55,-71.05,-37.65"
WORK_DIR="$HOME/nowcast-monitor-araucania"
NOWCAST_BIN="$HOME/nowcast-monitor/bin/nowcast"
# Intercepto REGIONAL a*=5.5 en MODO SOMBRA, como monitor@rm y como el
# pronóstico comunal de este dominio (variantes.py: GFS/ECMWF → regional-a5.5).
# NO está calibrado en la Araucanía (se calibró en el Maipo) y la región
# recibe lluvia frontal de 5+ mm/h por horas, así que la tasa de cruces puede
# ser alta: medirla una temporada antes de confiar; volver a Caine = 14.82.
ID_A=5.5
ID_B=0.39
K=4.0
DT_HOURS=0.5
MAX_WINDOW=96
# derivado por make_susc_grid.py para ESTE bbox (p90 de 16_araucania_transfer +
# 12_rio_biobio + 17_costa_transfer, con cascada post-incendio; submuestreo
# 56 m; mediana 0.782 → 0.391). Las capas de transferencia NO están validadas
# en destino (ver susceptibility_transfer_meta.json de cada una).
ALERT_LEVEL=0.391
CALIBRATOR=""
SUSC_TIF="$HOME/nowcast-monitor-araucania/susc_0p1.tif"
WINDOW_HOURS=54
MIN_STEPS=96
STALE_HOURS=6
MAX_GAP_FRACTION=0.10
GOES_ENABLED=1
GOES_BUCKET="noaa-goes19"
GOES_STALE_HOURS=1
# Rayos GLM: diagnóstico de convección (no forzante). Sin cicatrices vigentes
# en este bbox, así que aplica solo el aviso de dominio (≥50 descargas/60 min).
# El 12-oct la Araucanía tuvo hasta 160 descargas/10 min: esperar avisos
# frecuentes en días convectivos; los umbrales siguen provisionales.
GLM_ENABLED=1
GLM_LOOKBACK_MIN=60
GLM_BACKFILL_MIN=120
GLM_SCAR_BUFFER_KM=5
GLM_ALERT_FLASHES=10
GLM_ALERT_FLASHES_DOMAIN=50
GLM_REALERT_HOURS=2
GLM_STALE_HOURS=1
# EMAs DMC de la región que entregan minutario (probadas el 12-oct: 8 de 9;
# Angol Húsares 370067 no entrega datos desde julio y queda fuera). Todas en
# el valle salvo Lonquimay (precordillera, 912 m); no hay EMA en Curacautín.
# Token en monitor/config.local.env.
DGA_ENABLED=1
DGA_STATIONS="380063:-72.343:-38.229:Victoria,380018:-71.362:-38.455:Lonquimay,380032:-72.606:-38.661:Rucamanque UFRO,380013:-72.632:-38.768:Maquehue Temuco Ad,380033:-72.694:-38.838:Maquehue UFRO,380029:-72.653:-38.934:La Araucania Ad,390028:-72.112:-39.190:Villarrica,390056:-71.917:-39.291:Pucon Ad"
DGA_STALE_HOURS=3
COMBINE="noisy-or"
H0_CSV=""
H0_STALE_DAYS=3
H0_ABS_M=""
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC=""
REALERT_HOURS=6
ALERT_EPISODE_GAP_H=2
CORROB_ENABLED=1
CORROB_MIN_MM=1.0
CORROB_HOURS=3
CORROB_GLM_FLASHES=3
CORROB_FRACTION=0.5
FREEZE_EVIDENCE=1
FREEZE_PRE_H=6
FREEZE_POST_H=3
FREEZE_DIR=""
FREEZE_MIN_FREE_MB=500
RESTALE_HOURS=12
WRITE_HAZARD_TIFS=1
ARCHIVE_STEPS=1
