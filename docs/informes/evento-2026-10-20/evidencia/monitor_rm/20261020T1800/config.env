# Monitor RM — precordillera y cordillera de Santiago / Cajón del Maipo.
# Instanciado el 2026-10-11 tras el aluvión de Las Condes (8-oct): el piloto RM
# de monitor/config.env nunca tuvo timer propio; solo corría monitor@atacama.
# Derivado de monitor/config.env; cambian bbox (extendido al norte para cubrir
# Lo Barnechea entero), WORK_DIR, susceptibilidad (CON cascada post-incendio de
# San Carlos de Apoquindo), umbral y pluviómetros (se suma Tobalaba, la EMA que
# midió la ráfaga del 8-oct: 8.2 mm en la hora previa al aluvión).
BBOX="-70.85,-34.25,-69.75,-33.05"
WORK_DIR="$HOME/nowcast-monitor-rm"
NOWCAST_BIN="$HOME/nowcast-monitor/bin/nowcast"
# Intercepto REGIONAL a*=5.5 (calibrado en esta misma cuenca, paper §5.1), en
# MODO SOMBRA, decidido con la retrospectiva del 8-oct (aluvión de Las Condes):
# con Caine (14.82) NINGUNA forzante disponible —IMERG, GOES ni el pluviómetro
# de Tobalaba a 7 km con 8.2 mm/h— cruza el umbral en la cicatriz (peligro
# ≤0.05); con 5.5 el feed DGA con Tobalaba da 0.30 en la cicatriz (≥0.267) a la
# hora del evento. Costo medido en la ventana 7-9 oct: 17 de 168 pasos con
# alguna celda en alerta (cordillera SE), sin verificar en terreno → por eso
# SOMBRA: medir la tasa de falsas alarmas una temporada antes de confiar.
# Volver a Caine = ID_A=14.82 (atacama sigue en Caine).
ID_A=5.5
ID_B=0.39
K=4.0
DT_HOURS=0.5
MAX_WINDOW=96
# derivado por make_susc_grid.py para ESTE bbox y ESTA susceptibilidad (con
# cascada): ver la salida del script al generar susc_0p1.tif.
ALERT_LEVEL=0.267
CALIBRATOR=""
SUSC_TIF="$HOME/nowcast-monitor-rm/susc_0p1.tif"
WINDOW_HOURS=54
MIN_STEPS=96
STALE_HOURS=6
MAX_GAP_FRACTION=0.10
GOES_ENABLED=1
GOES_BUCKET="noaa-goes19"
GOES_STALE_HOURS=1
# Rayos GLM (2026-10-12): diagnóstico de convección; umbrales del template.
GLM_ENABLED=1
GLM_LOOKBACK_MIN=60
GLM_BACKFILL_MIN=120
GLM_SCAR_BUFFER_KM=5
GLM_ALERT_FLASHES=10
GLM_ALERT_FLASHES_DOMAIN=50
GLM_REALERT_HOURS=2
GLM_STALE_HOURS=1
# Pluviómetros DMC del dominio (token en monitor/config.local.env).
DGA_ENABLED=1
DGA_STATIONS="330077:-70.294:-33.350:El Colorado 2750m,330112:-70.351:-33.615:San Jose Guayacan,330122:-70.548:-33.545:Aguas Andinas La Florida,330019:-70.549:-33.455:Tobalaba Ad."
DGA_STALE_HOURS=3
COMBINE="noisy-or"
H0_CSV=""
H0_STALE_DAYS=3
H0_ABS_M=""
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC=""
REALERT_HOURS=6
RESTALE_HOURS=12
WRITE_HAZARD_TIFS=1
ARCHIVE_STEPS=1
