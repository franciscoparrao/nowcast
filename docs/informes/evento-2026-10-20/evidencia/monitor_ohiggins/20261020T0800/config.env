# Monitor O'HIGGINS — VI Región completa, costa (Pichilemu) a cordillera.
# Instanciado el 2026-10-20 en la madrugada, por las alertas de remoción en
# masa para la RM y la VI Región de ese día: el pronóstico 12z del 19-oct
# marcaba 17 comunas en ALTO (Santa Cruz, Lolol, Chépica, Pichilemu…) y la
# región no tenía monitor en vivo ni EMAs archivadas.
# Derivado de domains/araucania/config.env; cambian bbox, WORK_DIR,
# susceptibilidad, umbral y pluviómetros.
# Susceptibilidad: p90 del mosaico 10_rio_rapel + 17_costa_transfer (la costa
# al oeste de −71.86, fuera del ráster del Rapel) + 09_rio_maipo y 11_rio_maule
# (sin ellas las celdas de borde leían solo los píxeles de la divisoria y 52 de
# 240 quedaban mudas). Quedan 25 MUDAS a propósito (--allow-mute): valle plano
# y Lago Rapel (correcto), la fila sur −34.95 cuyo terreno es del Mataquito
# (sin modelo) y la alta cordillera del Tinguiririca (RandomForest ≈0.22).
# La capa costera es TRANSFERENCIA desde el Biobío, no validada en destino.
BBOX="-71.95,-34.95,-70.05,-33.85"
WORK_DIR="$HOME/nowcast-monitor-ohiggins"
NOWCAST_BIN="$HOME/nowcast-monitor/bin/nowcast"
# Intercepto REGIONAL a*=5.5 en MODO SOMBRA, como monitor@rm y como el
# pronóstico comunal de esta región (variantes.py: GFS/ECMWF → regional-a5.5).
# NO está calibrado en O'Higgins (se calibró en el Maipo, la cuenca vecina): medirla una temporada antes de confiar; volver a Caine = 14.82.
ID_A=5.5
ID_B=0.39
K=4.0
DT_HOURS=0.5
MAX_WINDOW=96
# derivado por make_susc_grid.py para ESTE bbox (mediana 0.637 → 0.318).
ALERT_LEVEL=0.318
CALIBRATOR=""
SUSC_TIF="$HOME/nowcast-monitor-ohiggins/susc_0p1.tif"
WINDOW_HOURS=54
MIN_STEPS=96
STALE_HOURS=6
MAX_GAP_FRACTION=0.10
GOES_ENABLED=1
GOES_BUCKET="noaa-goes19"
GOES_STALE_HOURS=1
# Rayos GLM: diagnóstico de convección (no forzante). Sin cicatrices vigentes
# en este bbox: aplica solo el aviso de dominio (≥50 descargas/60 min).
GLM_ENABLED=1
GLM_LOOKBACK_MIN=60
GLM_BACKFILL_MIN=120
GLM_SCAR_BUFFER_KM=5
GLM_ALERT_FLASHES=10
GLM_ALERT_FLASHES_DOMAIN=50
GLM_REALERT_HOURS=2
GLM_STALE_HOURS=1
# Las cinco EMAs DMC de la región (getEstacionesRedEma, region=6), probadas
# el 2026-10-20 contra la API: las cinco entregan minutario. Cuatro de valle o
# litoral; solo Portezuelo-Codelco (1185 m) está en precordillera.
# Token en monitor/config.local.env.
DGA_ENABLED=1
DGA_STATIONS="340045:-70.776:-34.172:Rancagua,340048:-70.997:-34.215:Quimavida,340066:-71.735:-34.661:Nilahue La Quebrada,340093:-70.579:-34.198:Portezuelo Codelco,340115:-72.019:-34.394:Pichilemu Ad"
DGA_STALE_HOURS=3
COMBINE="noisy-or"
H0_CSV=""
H0_STALE_DAYS=3
H0_ABS_M=""
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC=""
REALERT_HOURS=6
ALERT_EPISODE_GAP_H=2
CORROB_ENABLED=1
CORROB_MIN_MM=1.0
CORROB_HOURS=3
CORROB_GLM_FLASHES=3
CORROB_FRACTION=0.5
FREEZE_EVIDENCE=1
FREEZE_PRE_H=6
FREEZE_POST_H=3
FREEZE_DIR=""
FREEZE_MIN_FREE_MB=500
RESTALE_HOURS=12
WRITE_HAZARD_TIFS=1
ARCHIVE_STEPS=1
