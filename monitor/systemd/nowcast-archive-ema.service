[Unit]
Description=nowcast: archiva el minutario de las EMA de la DMC antes de que caduque
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# La API de la DMC sirve ~12 h y nada más. Sin este archivador, cualquier
# verificación posterior a un evento es imposible: cuando uno va a mirar, el
# dato ya no existe en ningún lado. Corre seguido y barato (~700 registros por
# estación). Las cuatro EMAs del dominio RM (DGA_STATIONS de monitor@rm): la
# primera alerta de rm (10-oct-2026) quedó sin verificar porque solo se
# archivaba El Colorado. Desde el 2026-10-12 también las ocho EMAs de
# monitor@araucania (380xxx/390xxx; Angol 370067 no entrega datos).
# Desde el 2026-10-19 también las cinco EMAs DMC de O'Higgins (340xxx), sin
# monitor en vivo todavía, por las alertas de remoción en masa del 20-oct.
ExecStart=%h/proyectos/nowcast/monitor/archive_ema.py --code 330077,330112,330122,330019,380063,380018,380032,380013,380033,380029,390028,390056,340045,340048,340066,340093,340115
Environment=DMC_USUARIO=
Environment=DMC_TOKEN=
# Las credenciales reales salen de monitor/config.local.env, que el script lee
# solo (gitignored). Las Environment= de arriba quedan vacías a propósito para
# no filtrar el token al journal de systemd.
TimeoutStartSec=5min
Nice=15
